{
  "name": "harnessmm-dsh",
  "version": "1.1.0",
  "description": "Guarded decision reuse for the DeepSeek Harness: the model authors already-decided tool actions once, and receipt-supported ones execute through the native tools without another reasoning request. Ships a read-only decision-reuse panel with per-number data provenance.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./engine": "./engine.js",
    "./panel": "./panel.js",
    "./snapshot": "./snapshot.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "engine.js",
    "panel.js",
    "snapshot.js",
    "web-routes.js",
    "panel.html",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check engine.js && node --check panel.js && node --check snapshot.js && node --check web-routes.js && node --check client.js",
    "test": "node --import ./tests/register-vendor.mjs --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent",
    "token-efficiency",
    "decision-reuse",
    "harnessmm",
    "panel",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xiuxiu-6/harnessmm-dsh.git"
  },
  "homepage": "https://github.com/Xiuxiu-6/harnessmm-dsh#readme",
  "bugs": {
    "url": "https://github.com/Xiuxiu-6/harnessmm-dsh/issues"
  },
  "license": "Apache-2.0"
}
